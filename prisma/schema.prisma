generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum JobStatus {
  QUEUED
  SCHEDULED
  CLAIMED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum JobType {
  IMMEDIATE
  DELAYED
  SCHEDULED
  CRON
  BATCH
}

enum RetryStrategy {
  FIXED
  LINEAR
  EXPONENTIAL
}

enum WorkerStatus {
  ONLINE
  DRAINING
  OFFLINE
}

enum DLQStatus {
  UNRESOLVED
  RETRIED
  DISCARDED
}

// ----------------------------------------------------
// ENTITIES
// ----------------------------------------------------

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  name         String?
  passwordHash String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  memberships  OrganizationMember[]

  @@index([email])
}

model Organization {
  id        String               @id @default(uuid())
  name      String
  slug      String               @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   OrganizationMember[]
  projects  Project[]

  @@index([slug])
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  slug           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queues        Queue[]
  scheduledJobs ScheduledJob[]
  workers       Worker[]

  @@unique([organizationId, name])
  @@unique([organizationId, slug])
  @@index([organizationId])
}

model RetryPolicy {
  id            String        @id @default(uuid())
  name          String        @unique
  strategy      RetryStrategy @default(EXPONENTIAL)
  baseDelayMs   Int           @default(1000)
  maxDelayMs    Int           @default(60000)
  maxAttempts   Int           @default(5)
  backoffFactor Float         @default(2.0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  queues        Queue[]
  jobs          Job[]
}

model Queue {
  id               String   @id @default(uuid())
  projectId        String
  retryPolicyId    String?
  name             String
  description      String?
  priority         Int      @default(0) // Higher number = higher priority queue
  concurrencyLimit Int      @default(10) // Max concurrent running jobs across workers
  isPaused         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  retryPolicy    RetryPolicy?    @relation(fields: [retryPolicyId], references: [id], onDelete: SetNull)
  jobs           Job[]
  scheduledJobs  ScheduledJob[]
  deadLetterJobs DeadLetterJob[]

  @@unique([projectId, name])
  @@index([projectId, isPaused])
  @@index([priority])
}

model Job {
  id             String    @id @default(uuid())
  queueId        String
  retryPolicyId  String?
  idempotencyKey String?
  type           JobType   @default(IMMEDIATE)
  status         JobStatus @default(QUEUED)
  priority       Int       @default(0) // Higher number = higher priority execution
  payload        Json      @default("{}")
  result         Json?
  errorMessage   String?
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(3)

  // Scheduling & Dynamic Lock Lease
  scheduledAt      DateTime  @default(now())
  lockedAt         DateTime?
  leaseExpiresAt   DateTime?
  lockedByWorkerId String?
  version          Int       @default(1) // Optimistic concurrency control

  // Batching & Hierarchical Workflows
  batchId     String?
  parentJobId String?

  // Timestamps
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  queue          Queue          @relation(fields: [queueId], references: [id], onDelete: Cascade)
  retryPolicy    RetryPolicy?   @relation(fields: [retryPolicyId], references: [id], onDelete: SetNull)
  lockedByWorker Worker?        @relation(fields: [lockedByWorkerId], references: [id], onDelete: SetNull)
  parentJob      Job?           @relation("JobHierarchy", fields: [parentJobId], references: [id], onDelete: SetNull)
  childJobs      Job[]          @relation("JobHierarchy")
  executions     JobExecution[]
  logs           JobLog[]
  deadLetterJob  DeadLetterJob?

  @@unique([queueId, idempotencyKey])
  // Critical indexes for worker claim queries (FOR UPDATE SKIP LOCKED):
  @@index([queueId, status, scheduledAt, priority, createdAt])
  // Critical index for crash recovery & stale lease reclamation:
  @@index([status, leaseExpiresAt])
  @@index([batchId])
  @@index([parentJobId])
  @@index([createdAt])
  @@index([lockedByWorkerId])
}

model JobExecution {
  id             String          @id @default(uuid())
  jobId          String
  workerId       String?
  attemptNumber  Int
  status         ExecutionStatus @default(RUNNING)
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  durationMs     Int?
  errorMessage   String?
  result         Json?
  workerMetadata Json?
  createdAt      DateTime        @default(now())

  job    Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker Worker?  @relation(fields: [workerId], references: [id], onDelete: SetNull)
  logs   JobLog[]

  @@index([jobId, createdAt])
  @@index([workerId])
}

model JobLog {
  id          String   @id @default(uuid())
  jobId       String
  executionId String?
  level       String   @default("INFO") // INFO, WARN, ERROR, DEBUG
  message     String
  metadata    Json?
  timestamp   DateTime @default(now())

  job       Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  execution JobExecution? @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([jobId, timestamp])
  @@index([executionId, timestamp])
}

model Worker {
  id              String       @id @default(uuid())
  workerId        String       @unique // Unique node/process identity (e.g. worker-host-pid-rand)
  projectId       String?
  hostname        String
  processId       Int?
  status          WorkerStatus @default(ONLINE)
  concurrency     Int          @default(5)
  activeJobsCount Int          @default(0)
  lastHeartbeatAt DateTime     @default(now())
  startedAt       DateTime     @default(now())
  stoppedAt       DateTime?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  claimedJobs Job[]
  executions  JobExecution[]
  heartbeats  WorkerHeartbeat[]

  @@index([status, lastHeartbeatAt])
}

model WorkerHeartbeat {
  id              String   @id @default(uuid())
  workerId        String
  timestamp       DateTime @default(now())
  activeJobsCount Int
  cpuUsagePct     Float?
  memoryUsageMb   Float?
  systemLoad      Json?

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, timestamp])
}

model ScheduledJob {
  id             String    @id @default(uuid())
  projectId      String
  queueId        String
  name           String
  jobType        JobType   @default(CRON)
  payload        Json      @default("{}")
  cronExpression String
  timezone       String    @default("UTC")
  priority       Int       @default(0)
  isEnabled      Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  queue   Queue   @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@index([isEnabled, nextRunAt])
  @@index([projectId])
}

model DeadLetterJob {
  id                String    @id @default(uuid())
  jobId             String    @unique
  queueId           String
  originalPayload   Json
  failureReason     String
  errorMessage      String
  finalAttemptCount Int
  status            DLQStatus @default(UNRESOLVED)
  failedAt          DateTime  @default(now())
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  queue Queue @relation(fields: [queueId], references: [id], onDelete: Cascade)

  @@index([queueId, status])
}
